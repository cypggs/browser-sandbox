# Browser Sandbox Environment Configuration
# Copy to .env and replace all secrets with strong random values (chmod 600 .env)

# Virtual display geometry (default 1920x1080)
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080
SCREEN_DEPTH=24
TZ=Asia/Shanghai

# Password for x11vnc / noVNC session (max 8 chars effective for standard VNC DES auth; use strong Nginx Basic Auth as primary layer)
VNC_PASSWORD=CHANGE_ME_VNC_PASS

# Bearer token / X-API-Key for AI Control HTTP API and MCP endpoint
API_TOKEN=CHANGE_ME_STRONG_RANDOM_API_TOKEN

# Reference metadata for Nginx HTTP Basic Auth (stored hashed in /etc/nginx/htpasswd-browser-sandbox)
NOVNC_BASIC_USER=sandbox
