# Nginx reverse proxy template for Browser Sandbox
# 1. Replace `browser.example.com` with your own domain.
# 2. Generate HTTP Basic Auth file:
#      HASH=$(openssl passwd -6 'YOUR_STRONG_PASSWORD')
#      printf 'sandbox:%s\n' "$HASH" | sudo tee /etc/nginx/htpasswd-browser-sandbox >/dev/null
#      sudo chmod 640 /etc/nginx/htpasswd-browser-sandbox
#      sudo chown root:www-data /etc/nginx/htpasswd-browser-sandbox
# 3. Copy to /etc/nginx/sites-available/browser-sandbox, symlink to sites-enabled, then run:
#      sudo certbot --nginx -d browser.example.com --redirect
#
# Routing:
# - /      : noVNC web viewer + WebSocket (/websockify), protected by HTTPS + HTTP Basic Auth + VNC password
# - /api/  : AI Control HTTP API & MCP endpoint, protected by HTTPS + Bearer Token (no Basic Auth)
# - CDP (127.0.0.1:9222) is intentionally NOT proxied and NEVER exposed publicly.

server {
    listen 80;
    server_name browser.example.com;

    client_max_body_size 50m;

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "no-referrer" always;

    # AI Control HTTP API & Streamable HTTP MCP Server (Bearer Token auth enforced by agent)
    location /api/ {
        auth_basic off;
        proxy_pass http://127.0.0.1:3800/;
        proxy_http_version 1.1;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # noVNC WebSocket endpoint
    location /websockify {
        auth_basic "Browser Sandbox Remote Desktop";
        auth_basic_user_file /etc/nginx/htpasswd-browser-sandbox;

        proxy_pass http://127.0.0.1:6080/websockify;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # noVNC static web UI
    location / {
        auth_basic "Browser Sandbox Remote Desktop";
        auth_basic_user_file /etc/nginx/htpasswd-browser-sandbox;

        proxy_pass http://127.0.0.1:6080;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
